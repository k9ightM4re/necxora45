    match /template_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId)
        && (resource == null || existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || isPrimaryAdminToken());
      allow create: if isSignedIn() && isValidId(reportId)
        && isValidTemplateReport(incoming(), reportId)
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/templates/$(incoming().templateId));
      allow update: if isSignedIn() && isValidId(reportId)
        && isAdmin()
        && isValidTemplateReport(incoming(), reportId)
        && incoming().id == existing().id
        && incoming().templateId == existing().templateId
        && incoming().reporterId == existing().reporterId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(reportId) && (existing().reporterId == request.auth.uid || isAdmin());
    }

    match /template_categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId);
      allow list: if isSignedIn() && existing().sortOrder >= 0;
      allow create: if isAdmin() && isValidId(categoryId)
        && isValidTemplateCategory(incoming(), categoryId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(categoryId)
        && isValidTemplateCategory(incoming(), categoryId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'active', 'sortOrder', 'updatedBy', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /ai_provider_settings/{configId} {
      allow get: if isSignedIn() && isValidId(configId) && (resource == null || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(configId)
        && isValidAiProviderSetting(incoming(), configId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(configId)
        && existing().userId == request.auth.uid
        && isValidAiProviderSetting(incoming(), configId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'label', 'baseUrl', 'textModel', 'imageModel', 'keyMasked', 'hasKey',
          'capabilities', 'isDefault', 'lastStatus', 'lastError', 'lastTestedAtMs', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(configId) && existing().userId == request.auth.uid;
    }
  }
}
