rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimaryAdminToken() {
      return isSignedIn()
        && request.auth.token.email == 'kj74647688@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isPrimaryAdminToken()
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isServerOwner(serverId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/servers/$(serverId))
        && get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid;
    }

    function isServerMember(serverId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid));
    }

    function isServerMemberOrOwner(serverId) {
      return isServerOwner(serverId) || isServerMember(serverId);
    }

    function hasApprovedJoinRequest(serverId, userId) {
      return exists(/databases/$(database)/documents/servers/$(serverId)/join_requests/$(userId))
        && get(/databases/$(database)/documents/servers/$(serverId)/join_requests/$(userId)).data.status == 'approved';
    }

    function hasValidInviteDoc(serverId, inviteCode) {
      return inviteCode is string
        && inviteCode.size() >= 2
        && inviteCode.size() <= 32
        && exists(/databases/$(database)/documents/invites/$(inviteCode))
        && get(/databases/$(database)/documents/invites/$(inviteCode)).data.serverId == serverId
        && get(/databases/$(database)/documents/invites/$(inviteCode)).data.active == true;
    }

    function hasAcceptedConnection(threadId) {
      return exists(/databases/$(database)/documents/connection_requests/$(threadId))
        && get(/databases/$(database)/documents/connection_requests/$(threadId)).data.status == 'accepted';
    }

    function isBlockedBy(targetUid, senderUid) {
      return exists(/databases/$(database)/documents/users/$(targetUid)/blocks/$(senderUid));
    }

    function isDmParticipant(threadId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/dm_threads/$(threadId))
        && request.auth.uid in get(/databases/$(database)/documents/dm_threads/$(threadId)).data.participants;
    }

    function isCallCaller(callId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/calls/$(callId))
        && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
    }

    function isCallParticipant(callId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/calls/$(callId))
        && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds;
    }

    // 3. Entity Validation Blueprints
    function isValidPublicUser(data) {
      return data.keys().hasAll(['id', 'username', 'displayName', 'initials', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'username', 'displayName', 'initials', 'avatar', 'coverPhoto',
          'bio', 'status', 'customStatus', 'accountPrivacy',
          'followersCount', 'followingCount', 'postsCount',
          'lastSeenMs', 'suspended', 'verified', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 50
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 16
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 200000))
        && (!('coverPhoto' in data) || (data.coverPhoto is string && data.coverPhoto.size() <= 300000))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('customStatus' in data) || (data.customStatus is string && data.customStatus.size() <= 200))
        && (!('accountPrivacy' in data) || data.accountPrivacy in ['everyone', 'requests_only', 'private'])
        && (!('followersCount' in data) || (data.followersCount is number && data.followersCount >= 0))
        && (!('followingCount' in data) || (data.followingCount is number && data.followingCount >= 0))
        && (!('postsCount' in data) || (data.postsCount is number && data.postsCount >= 0))
        && (!('lastSeenMs' in data) || data.lastSeenMs is number)
        && (!('suspended' in data) || data.suspended is bool)
        && (!('verified' in data) || data.verified is bool)
        && data.status in ['online', 'idle', 'dnd', 'offline', 'invisible']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly(['email', 'phoneNumber', 'authProvider', 'updatedAt'])
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40))
        && (!('authProvider' in data) || (data.authProvider is string && data.authProvider.size() <= 80))
        && data.updatedAt is timestamp;
    }

    function isValidFollow(data, edgeUid) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'username', 'avatar', 'createdAt'])
        && data.uid is string && data.uid == edgeUid && data.uid.size() <= 128
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 200000))
        && data.createdAt is timestamp;
    }

    function isValidBlock(data, blockedUid) {
      return data.keys().hasAll(['blockedUid', 'createdAt'])
        && data.keys().hasOnly(['blockedUid', 'blockedName', 'createdAt'])
        && data.blockedUid is string && data.blockedUid == blockedUid && data.blockedUid.size() <= 128
        && (!('blockedName' in data) || (data.blockedName is string && data.blockedName.size() <= 80))
        && data.createdAt is timestamp;
    }

    function isValidBookmark(data, bookmarkId) {
      return data.keys().hasAll(['id', 'sourceType', 'sourceId', 'messageId', 'authorName', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'sourceType', 'sourceId', 'messageId', 'authorName', 'content', 'mediaUrl', 'createdAt'])
        && data.id is string && data.id == bookmarkId && data.id.size() <= 128
        && data.sourceType in ['channel', 'dm', 'post', 'reel']
        && data.sourceId is string && data.sourceId.size() <= 128
        && data.messageId is string && data.messageId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 80
        && data.content is string && data.content.size() <= 2000
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 400000))
        && data.createdAt is timestamp;
    }

    function isValidJoinedServerRef(data, serverId) {
      return data.keys().hasAll(['serverId', 'joinedAt'])
        && data.keys().hasOnly(['serverId', 'joinedAt'])
        && data.serverId is string && data.serverId == serverId && data.serverId.size() <= 128
        && data.joinedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'body', 'unread', 'createdAt'])
        && data.keys().hasOnly(['id', 'senderId', 'category', 'targetId', 'title', 'body', 'unread', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && (!('senderId' in data) || (data.senderId is string && data.senderId.size() <= 128))
        && (!('category' in data) || (data.category is string && data.category.size() <= 32))
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && data.title is string && data.title.size() <= 120
        && data.body is string && data.body.size() <= 300
        && data.unread is bool
        && data.createdAt is timestamp;
    }

    function isValidPost(data, postId) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'content', 'visibility', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorUsername', 'authorInitials', 'authorAvatar', 'authorVerified',
          'content', 'mediaType', 'mediaItems', 'feeling', 'location',
          'hashtags', 'mentions', 'visibility', 'allowedViewerUids',
          'likesUids', 'likesCount', 'commentsCount', 'sharesCount',
          'edited', 'repostOfId', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == postId && data.id.size() <= 128
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && (!('authorUsername' in data) || (data.authorUsername is string && data.authorUsername.size() <= 50))
        && (!('authorInitials' in data) || (data.authorInitials is string && data.authorInitials.size() <= 16))
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 200000))
        && (!('authorVerified' in data) || data.authorVerified is bool)
        && data.content is string && data.content.size() <= 4000
        && (!('mediaType' in data) || data.mediaType in ['none', 'image', 'video', 'carousel'])
        && (!('mediaItems' in data) || (data.mediaItems is list && data.mediaItems.size() <= 4 && (data.mediaItems.size() == 0 || data.mediaItems[0] is map)))
        && (!('feeling' in data) || (data.feeling is string && data.feeling.size() <= 80))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100))
        && (!('hashtags' in data) || (data.hashtags is list && data.hashtags.size() <= 20))
        && (!('mentions' in data) || (data.mentions is list && data.mentions.size() <= 20))
        && data.visibility in ['public', 'followers', 'private']
        && (!('allowedViewerUids' in data) || (data.allowedViewerUids is list && data.allowedViewerUids.size() <= 500 && (data.allowedViewerUids.size() == 0 || data.allowedViewerUids[0] is string)))
        && (!('likesUids' in data) || (data.likesUids is list && data.likesUids.size() <= 500))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0))
        && (!('sharesCount' in data) || (data.sharesCount is number && data.sharesCount >= 0))
        && (!('edited' in data) || data.edited is bool)
        && (!('repostOfId' in data) || (data.repostOfId is string && data.repostOfId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComment(data, parentId, commentId) {
      return data.keys().hasAll(['id', 'parentId', 'authorId', 'authorName', 'content', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'parentId', 'authorId', 'authorName', 'authorInitials', 'authorAvatar', 'content', 'replyToId', 'replyToName', 'likesUids', 'edited', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == commentId && data.id.size() <= 128
        && data.parentId is string && data.parentId == parentId && data.parentId.size() <= 128
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && (!('authorInitials' in data) || (data.authorInitials is string && data.authorInitials.size() <= 16))
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 200000))
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 1500
        && (!('replyToId' in data) || (data.replyToId is string && data.replyToId.size() <= 128))
        && (!('replyToName' in data) || (data.replyToName is string && data.replyToName.size() <= 80))
        && (!('likesUids' in data) || (data.likesUids is list && data.likesUids.size() <= 200))
        && (!('edited' in data) || data.edited is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLike(data, userId) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'username', 'createdAt'])
        && data.userId is string && data.userId == userId && data.userId.size() <= 128
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && data.createdAt is timestamp;
    }

    function isValidStory(data, storyId) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'content', 'createdAt', 'expiresAtMs'])
        && data.keys().hasOnly(['id', 'userId', 'userName', 'userAvatar', 'userInitials', 'mediaType', 'mediaUrl', 'content', 'bgGradient', 'sticker', 'reactions', 'viewsCount', 'createdAt', 'expiresAtMs'])
        && data.id is string && data.id == storyId && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120
        && (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 200000))
        && (!('userInitials' in data) || (data.userInitials is string && data.userInitials.size() <= 16))
        && (!('mediaType' in data) || data.mediaType in ['text', 'image', 'video'])
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 550000))
        && data.content is string && data.content.size() <= 400
        && (!('bgGradient' in data) || (data.bgGradient is string && data.bgGradient.size() <= 120))
        && (!('sticker' in data) || (data.sticker is string && data.sticker.size() <= 40))
        && (!('reactions' in data) || data.reactions is map)
        && (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0))
        && data.expiresAtMs is number
        && data.createdAt is timestamp;
    }

    function isValidStoryView(data, viewerUid) {
      return data.keys().hasAll(['viewerUid', 'viewerName', 'viewedAt'])
        && data.keys().hasOnly(['viewerUid', 'viewerName', 'viewerAvatar', 'viewedAt'])
        && data.viewerUid is string && data.viewerUid == viewerUid && data.viewerUid.size() <= 128
        && data.viewerName is string && data.viewerName.size() <= 120
        && (!('viewerAvatar' in data) || (data.viewerAvatar is string && data.viewerAvatar.size() <= 200000))
        && data.viewedAt is timestamp;
    }

    function isValidReel(data, reelId) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'caption', 'videoUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorUsername', 'authorAvatar', 'authorInitials',
          'caption', 'hashtags', 'sourceType', 'youtubeId', 'videoUrl', 'posterUrl',
          'audioTitle', 'audioTrackId', 'audioDataUrl', 'musicVolume', 'videoVolume',
          'filterName', 'playbackSpeed', 'textOverlays',
          'likesUids', 'likesCount', 'commentsCount', 'viewsCount',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == reelId && data.id.size() <= 128
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && (!('authorUsername' in data) || (data.authorUsername is string && data.authorUsername.size() <= 50))
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 200000))
        && (!('authorInitials' in data) || (data.authorInitials is string && data.authorInitials.size() <= 16))
        && data.caption is string && data.caption.size() <= 1000
        && (!('hashtags' in data) || (data.hashtags is list && data.hashtags.size() <= 15 && (data.hashtags.size() == 0 || data.hashtags[0] is string)))
        && (!('sourceType' in data) || data.sourceType in ['video', 'youtube'])
        && (!('youtubeId' in data) || (data.youtubeId is string && data.youtubeId.size() <= 32))
        && data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 650000
        && (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 200000))
        && (!('audioTitle' in data) || (data.audioTitle is string && data.audioTitle.size() <= 100))
        && (!('audioTrackId' in data) || (data.audioTrackId is string && data.audioTrackId.size() <= 64))
        && (!('audioDataUrl' in data) || (data.audioDataUrl is string && data.audioDataUrl.size() <= 220000))
        && (!('musicVolume' in data) || (data.musicVolume is number && data.musicVolume >= 0 && data.musicVolume <= 1))
        && (!('videoVolume' in data) || (data.videoVolume is number && data.videoVolume >= 0 && data.videoVolume <= 1))
        && (!('filterName' in data) || (data.filterName is string && data.filterName.size() <= 32))
        && (!('playbackSpeed' in data) || (data.playbackSpeed is number && data.playbackSpeed >= 0.25 && data.playbackSpeed <= 4))
        && (!('textOverlays' in data) || (data.textOverlays is list && data.textOverlays.size() <= 12 && (data.textOverlays.size() == 0 || data.textOverlays[0] is map)))
        && (!('likesUids' in data) || (data.likesUids is list && data.likesUids.size() <= 500))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0))
        && (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMeeting(data, meetingId) {
      return data.keys().hasAll(['id', 'code', 'title', 'hostId', 'hostName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'code', 'title', 'description', 'hostId', 'hostName', 'scheduledFor', 'scheduledAtMs', 'status', 'callId', 'participantIds', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == meetingId && data.id.size() <= 128
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 32
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.hostId is string && data.hostId.size() <= 128
        && data.hostName is string && data.hostName.size() <= 120
        && (!('scheduledFor' in data) || (data.scheduledFor is string && data.scheduledFor.size() <= 64))
        && (!('scheduledAtMs' in data) || data.scheduledAtMs is number)
        && data.status in ['scheduled', 'live', 'ended']
        && (!('callId' in data) || (data.callId is string && data.callId.size() <= 128))
        && (!('participantIds' in data) || (data.participantIds is list && data.participantIds.size() <= 50))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMeetingChat(data, meetingId, msgId) {
      return data.keys().hasAll(['id', 'meetingId', 'senderId', 'senderName', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'meetingId', 'senderId', 'senderName', 'content', 'createdAt'])
        && data.id is string && data.id == msgId && data.id.size() <= 128
        && data.meetingId is string && data.meetingId == meetingId && data.meetingId.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 120
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidLiveStream(data, streamId) {
      return data.keys().hasAll(['id', 'hostId', 'hostName', 'title', 'status', 'startedAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'hostId', 'hostName', 'hostAvatar', 'hostInitials', 'title', 'category', 'status', 'sourceMode', 'viewerUids', 'viewerCount', 'reactionCount', 'callId', 'startedAt', 'updatedAt'])
        && data.id is string && data.id == streamId && data.id.size() <= 128
        && data.hostId is string && data.hostId.size() <= 128
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 120
        && (!('hostAvatar' in data) || (data.hostAvatar is string && data.hostAvatar.size() <= 200000))
        && (!('hostInitials' in data) || (data.hostInitials is string && data.hostInitials.size() <= 16))
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && (!('category' in data) || (data.category is string && data.category.size() <= 40))
        && data.status in ['live', 'ended']
        && (!('sourceMode' in data) || data.sourceMode in ['camera', 'screen', 'board'])
        && (!('viewerUids' in data) || (data.viewerUids is list && data.viewerUids.size() <= 200))
        && (!('viewerCount' in data) || (data.viewerCount is number && data.viewerCount >= 0))
        && (!('reactionCount' in data) || (data.reactionCount is number && data.reactionCount >= 0))
        && (!('callId' in data) || (data.callId is string && data.callId.size() <= 128))
        && data.startedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLiveChat(data, streamId, msgId) {
      return data.keys().hasAll(['id', 'streamId', 'senderId', 'senderName', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'streamId', 'senderId', 'senderName', 'content', 'reaction', 'createdAt'])
        && data.id is string && data.id == msgId && data.id.size() <= 128
        && data.streamId is string && data.streamId == streamId && data.streamId.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 120
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 500
        && (!('reaction' in data) || (data.reaction is string && data.reaction.size() <= 20))
        && data.createdAt is timestamp;
    }

    function isValidConnectionRequest(data, requestId) {
      return data.keys().hasAll(['id', 'fromUid', 'toUid', 'participantIds', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'fromUid', 'fromName', 'fromInitials', 'toUid', 'toName', 'toInitials', 'participantIds', 'status', 'note', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == requestId && data.id.size() <= 128
        && data.fromUid is string && data.fromUid.size() <= 128
        && data.toUid is string && data.toUid.size() <= 128
        && data.fromUid != data.toUid
        && (!('fromName' in data) || (data.fromName is string && data.fromName.size() <= 80))
        && (!('fromInitials' in data) || (data.fromInitials is string && data.fromInitials.size() <= 16))
        && (!('toName' in data) || (data.toName is string && data.toName.size() <= 80))
        && (!('toInitials' in data) || (data.toInitials is string && data.toInitials.size() <= 16))
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.participantIds is list && data.participantIds.size() == 2
        && data.fromUid in data.participantIds
        && data.toUid in data.participantIds
        && data.status in ['pending', 'accepted', 'declined']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvite(data, inviteCode) {
      return data.keys().hasAll(['code', 'serverId', 'serverName', 'ownerId', 'createdBy', 'active', 'uses', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'serverId', 'serverName', 'serverCategory', 'serverDescription', 'serverRules', 'ownerId', 'createdBy', 'createdByName', 'active', 'expiresAtMs', 'maxUses', 'uses', 'createdAt', 'updatedAt'])
        && data.code is string && data.code == inviteCode && data.code.size() >= 2 && data.code.size() <= 32
        && data.serverId is string && data.serverId.size() <= 128
        && data.serverName is string && data.serverName.size() >= 2 && data.serverName.size() <= 50
        && (!('serverCategory' in data) || (data.serverCategory is string && data.serverCategory.size() <= 50))
        && (!('serverDescription' in data) || (data.serverDescription is string && data.serverDescription.size() <= 300))
