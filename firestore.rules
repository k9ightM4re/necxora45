        && data.id is string && data.id == reportId && data.id.size() <= 128
        && data.templateId is string && data.templateId.size() >= 1 && data.templateId.size() <= 128
        && (!('templateTitle' in data) || (data.templateTitle is string && data.templateTitle.size() <= 120))
        && data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128
        && (!('reporterName' in data) || (data.reporterName is string && data.reporterName.size() <= 120))
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 120
        && (!('details' in data) || (data.details is string && data.details.size() <= 500))
        && data.status in ['open', 'resolved', 'dismissed']
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTemplateCategory(data, categoryId) {
      return data.keys().hasAll(['id', 'name', 'slug', 'active', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'active', 'sortOrder', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == categoryId && data.id.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 60
        && (!('description' in data) || (data.description is string && data.description.size() <= 240))
        && data.active is bool
        && data.sortOrder is number && data.sortOrder >= 0
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiProviderSetting(data, configId) {
      return data.keys().hasAll(['id', 'userId', 'provider', 'label', 'textModel', 'hasKey', 'isDefault', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'provider', 'label', 'baseUrl', 'textModel', 'imageModel', 'keyMasked', 'hasKey', 'capabilities', 'isDefault', 'lastStatus', 'lastError', 'lastTestedAtMs', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == configId && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.provider in ['gemini', 'openai', 'openai_compatible']
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 80
        && (!('baseUrl' in data) || (data.baseUrl is string && data.baseUrl.size() <= 300))
        && data.textModel is string && data.textModel.size() >= 1 && data.textModel.size() <= 100
        && (!('imageModel' in data) || (data.imageModel is string && data.imageModel.size() <= 100))
        && (!('keyMasked' in data) || (data.keyMasked is string && data.keyMasked.size() <= 40))
        && data.hasKey is bool
        && (!('capabilities' in data) || data.capabilities is map)
        && data.isDefault is bool
        && (!('lastStatus' in data) || (data.lastStatus is string && data.lastStatus.size() <= 40))
        && (!('lastError' in data) || (data.lastError is string && data.lastError.size() <= 300))
        && (!('lastTestedAtMs' in data) || data.lastTestedAtMs is number)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Match Rules
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    match /admins/{adminUid} {
      allow get: if (isOwner(adminUid) || isAdmin()) && isValidId(adminUid);
      allow list: if false;
      allow create, update, delete: if isAdmin() && isValidId(adminUid);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().status in ['online', 'idle', 'dnd', 'offline', 'invisible'];
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidPublicUser(incoming())
        && incoming().id == request.auth.uid
        && !('suspended' in incoming())
        && !('verified' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(userId)
        && isValidPublicUser(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'initials', 'avatar', 'coverPhoto', 'bio', 'status', 'customStatus', 'accountPrivacy', 'followersCount', 'followingCount', 'postsCount', 'lastSeenMs', 'updatedAt'])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['suspended', 'verified', 'status', 'updatedAt'])) ||
          (
            userId != request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
            && (
              (
                !isBlockedBy(userId, request.auth.uid)
                && !exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && incoming().followersCount == (('followersCount' in existing() && existing().followersCount is number ? existing().followersCount : 0) + 1)
              ) || (
                exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && incoming().followersCount == (('followersCount' in existing() && existing().followersCount is number && existing().followersCount > 0) ? existing().followersCount - 1 : 0)
              )
            )
          )
        );
      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);

      match /private/{docId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(docId)
          && isValidPrivateInfo(incoming())
          && incoming().updatedAt == request.time;
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(docId);
      }

      match /followers/{followerUid} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(followerUid);
        allow list: if isSignedIn() && existing().uid > '';
        allow create: if isOwner(followerUid) && isValidId(userId) && isValidId(followerUid)
          && userId != followerUid
          && !isBlockedBy(userId, request.auth.uid)
          && isValidFollow(incoming(), followerUid)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if (isOwner(followerUid) || isOwner(userId)) && isValidId(userId) && isValidId(followerUid);
      }

      match /following/{targetUid} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(targetUid);
        allow list: if isSignedIn() && existing().uid > '';
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(targetUid)
          && userId != targetUid
          && !isBlockedBy(targetUid, request.auth.uid)
          && isValidFollow(incoming(), targetUid)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(targetUid);
      }

      match /blocks/{blockedUid} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(blockedUid);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(blockedUid)
          && isValidBlock(incoming(), blockedUid)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(blockedUid);
      }

      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId)
          && isValidBookmark(incoming(), bookmarkId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
      }

      match /joined_servers/{serverId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(serverId)
          && (isOwner(userId) || isServerOwner(serverId));
        allow list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isSignedIn() && isValidId(userId) && isValidId(serverId)
          && isValidJoinedServerRef(incoming(), serverId)
          && (isServerOwner(serverId) || (isOwner(userId) && isServerMemberOrOwner(serverId)))
          && incoming().joinedAt == request.time;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(serverId)
          && (isOwner(userId) || isServerOwner(serverId));
      }

      match /notifications/{notifId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(notifId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isSignedIn() && isValidId(userId) && isValidId(notifId)
          && isValidNotification(incoming())
          && incoming().createdAt == request.time
          && (isOwner(userId) || ('senderId' in incoming() && incoming().senderId == request.auth.uid));
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(notifId)
          && isValidNotification(incoming())
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['unread']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(notifId);
      }
    }

    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId)
        && (
          resource == null ||
          existing().visibility == 'public' ||
          existing().authorId == request.auth.uid ||
          isAdmin() ||
          (existing().visibility == 'followers' && (
            exists(/databases/$(database)/documents/users/$(existing().authorId)/followers/$(request.auth.uid)) ||
            ('allowedViewerUids' in existing() && existing().allowedViewerUids is list && request.auth.uid in existing().allowedViewerUids)
          ))
        );
      allow list: if isSignedIn() && (
        existing().visibility == 'public' ||
        existing().authorId == request.auth.uid ||
        (existing().visibility == 'followers' && request.auth.uid in existing().allowedViewerUids)
      );
      allow create: if isSignedIn() && isValidId(postId)
        && isValidPost(incoming(), postId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(postId)
        && isValidPost(incoming(), postId)
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (existing().authorId == request.auth.uid || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'feeling', 'location', 'hashtags', 'mentions', 'visibility', 'allowedViewerUids', 'edited', 'updatedAt'])
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesUids', 'likesCount', 'updatedAt'])
            && (
              (
                !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
                && incoming().likesCount == (('likesCount' in existing() && existing().likesCount is number ? existing().likesCount : 0) + 1)
              ) || (
                (
                  exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)) ||
                  ('likesUids' in existing() && existing().likesUids is list && request.auth.uid in existing().likesUids)
                )
                && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
                && !(request.auth.uid in incoming().likesUids)
                && incoming().likesCount == (('likesCount' in existing() && existing().likesCount is number && existing().likesCount > 0) ? existing().likesCount - 1 : 0)
              )
            )
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && (
              incoming().commentsCount == (('commentsCount' in existing() && existing().commentsCount is number ? existing().commentsCount : 0) + 1) ||
              incoming().commentsCount == (('commentsCount' in existing() && existing().commentsCount is number && existing().commentsCount > 0) ? existing().commentsCount - 1 : 0)
            )
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'updatedAt'])
            && incoming().sharesCount == (('sharesCount' in existing() && existing().sharesCount is number ? existing().sharesCount : 0) + 1)
          )
        );
      allow delete: if isSignedIn() && isValidId(postId) && (existing().authorId == request.auth.uid || isAdmin());

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(userId);
        allow list: if isSignedIn() && existing().userId > '';
        allow create: if isOwner(userId) && isValidId(postId) && isValidId(userId)
          && isValidLike(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(userId)
          && (isOwner(userId) || isAdmin());
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && existing().parentId == postId;
        allow create: if isSignedIn() && isValidId(postId) && isValidId(commentId)
          && isValidComment(incoming(), postId, commentId)
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow update: if isSignedIn() && isValidId(postId) && isValidId(commentId)
          && isValidComment(incoming(), postId, commentId)
          && incoming().id == existing().id
          && incoming().parentId == existing().parentId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'edited', 'updatedAt'])) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['likesUids', 'updatedAt'])
          );
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId)
          && (
            existing().authorId == request.auth.uid ||
            get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId);
      allow list: if isSignedIn() && existing().expiresAtMs > 0;
      allow create: if isSignedIn() && isValidId(storyId)
        && isValidStory(incoming(), storyId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(storyId)
        && isValidStory(incoming(), storyId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          existing().userId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
        );
      allow delete: if isSignedIn() && isValidId(storyId) && (existing().userId == request.auth.uid || isAdmin());

      match /views/{viewerUid} {
        allow get: if isSignedIn() && isValidId(storyId) && isValidId(viewerUid);
        allow list: if isSignedIn() && existing().viewerUid > '';
        allow create, update: if isOwner(viewerUid) && isValidId(storyId) && isValidId(viewerUid)
          && isValidStoryView(incoming(), viewerUid)
          && incoming().viewedAt == request.time;
        allow delete: if isOwner(viewerUid) && isValidId(storyId) && isValidId(viewerUid);
      }
    }

    match /reels/{reelId} {
      allow get: if isSignedIn() && isValidId(reelId);
      allow list: if isSignedIn() && existing().id > '';
      allow create: if isSignedIn() && isValidId(reelId)
        && isValidReel(incoming(), reelId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(reelId)
        && isValidReel(incoming(), reelId)
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (existing().authorId == request.auth.uid || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'hashtags', 'audioTitle', 'audioTrackId', 'audioDataUrl', 'musicVolume', 'videoVolume', 'filterName', 'playbackSpeed', 'textOverlays', 'updatedAt'])
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesUids', 'likesCount', 'updatedAt'])
            && (
              (
                !exists(/databases/$(database)/documents/reels/$(reelId)/likes/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/reels/$(reelId)/likes/$(request.auth.uid))
                && incoming().likesCount == (('likesCount' in existing() && existing().likesCount is number ? existing().likesCount : 0) + 1)
              ) || (
                (
                  exists(/databases/$(database)/documents/reels/$(reelId)/likes/$(request.auth.uid)) ||
                  ('likesUids' in existing() && existing().likesUids is list && request.auth.uid in existing().likesUids)
                )
                && !existsAfter(/databases/$(database)/documents/reels/$(reelId)/likes/$(request.auth.uid))
                && !(request.auth.uid in incoming().likesUids)
                && incoming().likesCount == (('likesCount' in existing() && existing().likesCount is number && existing().likesCount > 0) ? existing().likesCount - 1 : 0)
              )
            )
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
            && (
              incoming().commentsCount == (('commentsCount' in existing() && existing().commentsCount is number ? existing().commentsCount : 0) + 1) ||
              incoming().commentsCount == (('commentsCount' in existing() && existing().commentsCount is number && existing().commentsCount > 0) ? existing().commentsCount - 1 : 0)
            )
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt'])
            && incoming().viewsCount == (('viewsCount' in existing() && existing().viewsCount is number ? existing().viewsCount : 0) + 1)
          )
        );
      allow delete: if isSignedIn() && isValidId(reelId) && (existing().authorId == request.auth.uid || isAdmin());

      match /likes/{userId} {
        allow get: if isSignedIn() && isValidId(reelId) && isValidId(userId);
        allow list: if isSignedIn() && existing().userId > '';
        allow create: if isOwner(userId) && isValidId(reelId) && isValidId(userId)
          && isValidLike(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/reels/$(reelId));
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(reelId) && isValidId(userId)
          && (isOwner(userId) || isAdmin());
      }

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(reelId) && isValidId(commentId);
        allow list: if isSignedIn() && existing().parentId == reelId;
        allow create: if isSignedIn() && isValidId(reelId) && isValidId(commentId)
          && isValidComment(incoming(), reelId, commentId)
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/reels/$(reelId));
        allow update: if isSignedIn() && isValidId(reelId) && isValidId(commentId)
          && isValidComment(incoming(), reelId, commentId)
          && incoming().id == existing().id
          && incoming().parentId == existing().parentId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'edited', 'updatedAt'])) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['likesUids', 'updatedAt'])
          );
        allow delete: if isSignedIn() && isValidId(reelId) && isValidId(commentId)
          && (
            existing().authorId == request.auth.uid ||
            get(/databases/$(database)/documents/reels/$(reelId)).data.authorId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    match /meetings/{meetingId} {
      allow get: if isSignedIn() && isValidId(meetingId);
      allow list: if isSignedIn() && existing().status in ['scheduled', 'live', 'ended'];
      allow create: if isSignedIn() && isValidId(meetingId)
        && isValidMeeting(incoming(), meetingId)
        && incoming().hostId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(meetingId)
        && isValidMeeting(incoming(), meetingId)
        && incoming().id == existing().id
        && incoming().hostId == existing().hostId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          existing().hostId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'status', 'updatedAt'])
        );
      allow delete: if isSignedIn() && isValidId(meetingId) && (existing().hostId == request.auth.uid || isAdmin());

      match /chat/{msgId} {
        allow get: if isSignedIn() && isValidId(meetingId) && isValidId(msgId);
        allow list: if isSignedIn() && existing().meetingId == meetingId;
        allow create: if isSignedIn() && isValidId(meetingId) && isValidId(msgId)
          && isValidMeetingChat(incoming(), meetingId, msgId)
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(meetingId) && isValidId(msgId)
          && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    match /live_streams/{streamId} {
      allow get: if isSignedIn() && isValidId(streamId);
      allow list: if isSignedIn() && existing().status in ['live', 'ended'];
      allow create: if isSignedIn() && isValidId(streamId)
        && isValidLiveStream(incoming(), streamId)
        && incoming().hostId == request.auth.uid
        && incoming().startedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(streamId)
        && isValidLiveStream(incoming(), streamId)
        && incoming().id == existing().id
        && incoming().hostId == existing().hostId
        && incoming().startedAt == existing().startedAt
        && incoming().updatedAt == request.time
        && (
          existing().hostId == request.auth.uid ||
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['viewerUids', 'viewerCount', 'reactionCount', 'updatedAt'])
        );
      allow delete: if isSignedIn() && isValidId(streamId) && (existing().hostId == request.auth.uid || isAdmin());

      match /chat/{msgId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(msgId);
        allow list: if isSignedIn() && existing().streamId == streamId;
        allow create: if isSignedIn() && isValidId(streamId) && isValidId(msgId)
          && isValidLiveChat(incoming(), streamId, msgId)
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(streamId) && isValidId(msgId)
          && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    match /connection_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId)
        && (resource == null || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;
      allow create: if isSignedIn() && isValidId(requestId)
        && isValidConnectionRequest(incoming(), requestId)
        && incoming().fromUid == request.auth.uid
        && incoming().status == 'pending'
        && !isBlockedBy(incoming().toUid, request.auth.uid)
        && incoming().createdAt == request.time
