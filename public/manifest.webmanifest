{
  "id": "/",
  "name": "NEXORA — Connect. Create. Share.",
  "short_name": "NEXORA",
  "description": "Social feeds, stories, reels, real-time messaging, video calls, live streaming, and communities in one app.",
  "start_url": "/app.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#200809",
  "theme_color": "#FFF0DC",
  "orientation": "any",
  "lang": "en",
  "categories": ["social", "communication", "photo", "video"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Open Workspace", "short_name": "Workspace", "url": "/app.html", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Join Invite", "short_name": "Invite", "url": "/welcome.html", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sign In", "short_name": "Sign In", "url": "/login.html", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
